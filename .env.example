# Copie este archivo como .env y ajuste los valores.

# Base de datos.
#   Local (por defecto si se omite): sqlite:///./estudiantes.db
#   Nube: la "Internal/External Database URL" de Render o Neon, ej.
#   postgresql://usuario:clave@host:5432/basedatos
DATABASE_URL=sqlite:///./estudiantes.db

# reCAPTCHA v2 ("No soy un robot"). Claves de PRUEBA de Google: funcionan en cualquier
# dominio, siempre pasan y muestran un aviso rojo. Cámbielas por las suyas (ver README).
RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# Orígenes permitidos (CORS), separados por coma. "*" = cualquiera.
CORS_ORIGINS=*
